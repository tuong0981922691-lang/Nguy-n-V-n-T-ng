rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Không cho phép quét danh sách toàn bộ người dùng
      
      allow create: if isOwner(userId) 
        && isValidId(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256;

      allow update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 256;

      allow delete: if isOwner(userId);

      // Subcollection: Ghi chú câu tục ngữ chân đế
      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        
        allow create: if isOwner(userId)
          && isValidId(noteId)
          && request.resource.data.userId == userId
          && request.resource.data.cau is string
          && request.resource.data.cau.size() <= 300
          && request.resource.data.danhGia in ['dung', 'sai', 'ngo'];

        allow update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.cau is string
          && request.resource.data.cau.size() <= 300
          && request.resource.data.danhGia in ['dung', 'sai', 'ngo'];

        allow delete: if isOwner(userId);
      }

      // Subcollection: Video đã đánh dấu
      match /bookmarks/{bookmarkId} {
        allow get, list: if isOwner(userId);
        
        allow create: if isOwner(userId)
          && isValidId(bookmarkId)
          && request.resource.data.userId == userId
          && request.resource.data.me is string
          && request.resource.data.me.size() <= 100;

        allow update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.me is string
          && request.resource.data.me.size() <= 100;

        allow delete: if isOwner(userId);
      }
    }
  }
}
